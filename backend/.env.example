PORT=5000
MONGO_URI=mongodb://localhost:27017/library_system
JWT_SECRET=change_this_to_a_long_random_secret_string
CLIENT_URL=http://localhost:3000

# Google OAuth (backend/routes/authRoutes.js) - create an OAuth 2.0 Client ID
# at https://console.cloud.google.com/apis/credentials to get these. Callback
# URL must match the route's actual mount path: /api/auth/google/callback,
# and must also be added to the client's "Authorized redirect URIs" in the
# Google Cloud Console exactly as written here.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Optional - only read by scripts/createAdmin.js, to bootstrap the first
# admin account non-interactively. Leave unset and the script will prompt
# for these instead.
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
